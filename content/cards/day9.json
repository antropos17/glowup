  },
  {
    "id": "K9-01",
    "kind": "story",
    "title": "Весы",
    "when": {
      "days": [
        9,
        9
      ],
      "parts": [
        "morning"
      ]
    },
    "text": "Весы стоят третий день. Та же цифра, что в субботу.",
    "choices": [
      {
        "id": "ok",
        "neutral": true,
        "label": "Слезть с весов",
        "outcomes": [
          {
            "if": [
              {
                "problem": "weight",
                "lte": 78
              }
            ],
            "text": "Первые килограммы уходят быстро, дальше вес идёт медленнее. Это не откат, так у всех."
          },
          {
            "if": [
              {
                "problem": "weight",
                "gte": 79
              }
            ],
            "text": "Цифра стоит, потому что её пока почти ничего не двигало. Пробежки и еда сделают своё, но не сразу."
          }
        ]
      }
    ]
  },
  {
