    "when": {
      "days": [
        4,
        4
      ],
      "parts": [
        "day"
      ]
    },
    "text": "«Андрюха, вечером шашлыки у меня на даче. Наши будут. Приходи, мясо на мне». Мяса там будет гора, и курят у мангала все: чтобы держаться, понадобятся силы.",
    "choices": [
      {
        "id": "go",
        "label": "Написать «Буду»",
        "outcomes": [
          {
            "text": "Витя: «Вот это разговор. К семи». Вечером шашлыки.",
            "effects": [
              {
                "problem": "conf",
                "add": -1
              },
              {
                "flag": "d4_went"
              }
            ]
          }
        ]
      },
      {
        "id": "home",
        "neutral": true,
        "label": "Написать «Не сегодня»",
        "outcomes": [
          {
            "text": "«Не сегодня», — написал {hero}. Витя: «Ну смотри. Фотки пришлю».",
            "effects": [
              {
                "flag": "d4_home"
              }
            ]
          }
        ]
      }
    ]
  },
