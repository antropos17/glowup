              {
                "hint": "derm_number"
              },
              {
                "flag": "d2_derm_slot",
                "value": "morning"
              }
            ]
          },
          {
            "if": [
              {
                "flag": "d1_one_pie"
              }
            ],
            "text": "«Один. Остальные в холодильнике». Мама: «Смотри, чтобы не пропали».",
