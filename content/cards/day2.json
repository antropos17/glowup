                    {
                      "flag": "d1_refused_pies"
                    }
                  ]
                }
              }
            ],
            "text": "Мама: «Ладно, потом расскажешь. К врачу сходи».",
            "effects": [
              {
                "hint": "derm_number"
              },
              {
                "flag": "d2_derm_slot",
                "value": "morning"
